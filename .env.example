# Copy to .env and fill locally. Never commit .env. Staging defaults only.
CARGO_ENV=staging
CARGO_UTM_HOST=utm.cargo.test
# Optional public URL behind the host reverse proxy; keep origin host above.
CARGO_PUBLIC_UTM_URL=
CARGO_GO_HOST=go.cargo.test
# Enable only after configuring a working public redirect domain.
CARGO_SHORT_LINKS_ENABLED=0
# Exact normalized ASCII/IDNA hosts, comma-separated, no spaces or wildcards.
CARGO_ALLOWED_HOSTS=fuel.cargo.example
CARGO_TABLE_PREFIX=wp_
CARGO_DB_NAME=cargo_staging
CARGO_DB_USER=cargo_wp
CARGO_DB_PASSWORD=
CARGO_DB_ROOT_PASSWORD=
CARGO_GO_DB_USER=cargo_go
CARGO_GO_DB_PASSWORD=
CARGO_WP_ADMIN_USER=cargo_admin
CARGO_WP_ADMIN_PASSWORD=
CARGO_WP_ADMIN_EMAIL=admin@cargo.test
# Paths outside published trees. TLS certificate must cover BOTH origin hosts.
CARGO_TLS_CERT=./secrets/tls.crt
CARGO_TLS_KEY=./secrets/tls.key
# Bind only to loopback. For canonical links, forward local 443 to 18443.
CARGO_BIND=127.0.0.1
CARGO_HTTP_PORT=18080
CARGO_HTTPS_PORT=18443
WORDPRESS_IMAGE=wordpress:php8.3-fpm
MARIADB_IMAGE=mariadb:10.11
NGINX_IMAGE=nginx:stable-alpine

# Corporate email login. Fill SMTP credentials locally; enable after delivery QA.
CARGO_EMAIL_LOGIN_ENABLED=0
CARGO_SMTP_HOST=
CARGO_SMTP_PORT=587
# tls = STARTTLS, ssl = implicit TLS; use your provider's documented setting.
CARGO_SMTP_SECURITY=tls
CARGO_SMTP_USER=
CARGO_SMTP_PASSWORD=
CARGO_SMTP_FROM=no-reply@utmqr.kit-rb.com

# Intermediate-page visit tracking; enable only after migration/grants and latency QA.
CARGO_TRACKING_ENABLED=0
# Generate 32 random bytes as 64 hex characters locally; never publish this key.
CARGO_TRACKING_KEY=

# Обмен визиток. Реальные документы настраивает оператор после согласования.
LEGAL_TEXTS_APPROVED=false
CARGO_CARDS_LEGAL_JSON=
CARGO_CARDS_TTL=600
CARGO_CARDS_SYNTHETIC=0
